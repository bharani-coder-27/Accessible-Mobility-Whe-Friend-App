# Direct PostgreSQL connection for Prisma migrations and seeding.
DATABASE_URL=postgresql://user:password@direct-host/db?sslmode=require

# Optional Neon pooled connection for the running API.
DATABASE_URL_POOLED=postgresql://user:password@pooled-host/db?sslmode=require

# Server Port
PORT=8801

# JWT Secret — change this in production!
JWT_SECRET=your_secret_key_here_change_this_in_production

# Environment
NODE_ENV=development
